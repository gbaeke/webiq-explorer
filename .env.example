# Web IQ Explorer settings. Copy to .env (git ignores it) and adjust; every setting in config.py is listed here.

# --- App ---------------------------------------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8837

# --- Web IQ ------------------------------------------------------------------------------------------------------------
# API key from https://webiq.microsoft.ai/profiles (Profile Management > API Keys). Stays on the server.
WEBIQ_API_KEY=
WEBIQ_BASE_URL=https://api.microsoft.ai/v3
# seconds per upstream call
WEBIQ_TIMEOUT_SECONDS=60

# --- Assistant (popup agent: a model via agentgateway, Web IQ via its MCP server) --------------------------------------
AGENT_BASE_URL=http://localhost:4000/v1
AGENT_MODEL=azure-gpt-6-luna
AGENT_API_KEY=not-needed
# seconds per model call
AGENT_TIMEOUT_SECONDS=60
